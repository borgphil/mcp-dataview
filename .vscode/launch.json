{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "REST API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "jinja": true
    },
    {
      "name": "MCP Server",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "args": ["--mcp"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "Initialize SQLite Database",
      "type": "debugpy",
      "request": "launch",
      "module": "app.database.sample_db",
      "args": ["--database", "${workspaceFolder}/data/sample.db"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    }
  ]
}