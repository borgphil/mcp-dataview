{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tail MCP logs",
      "type": "shell",
      "command": "tail",
      "args": ["-f", "${workspaceFolder}/logs/mcp.log"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run REST server in terminal",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000", "--log-level", "info"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src", "APP_LOG_LEVEL": "INFO", "APP_LOG_STREAM": "stdout" } },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Initialize sample SQLite database",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.database.sample_db", "--database", "${workspaceFolder}/data/sample.db"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "problemMatcher": []
    },
    {
      "label": "Reset sample SQLite database",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.database.sample_db", "--database", "${workspaceFolder}/data/sample.db", "--reset"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pytest",
      "args": ["-q"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "problemMatcher": []
    }
  ]
}