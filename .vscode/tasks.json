{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Initialize sample SQLite database",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.database.sample_db", "--database", "${workspaceFolder}/data/sample.db"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "problemMatcher": []
    },
    {
      "label": "Reset sample SQLite database",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.database.sample_db", "--database", "${workspaceFolder}/data/sample.db", "--reset"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pytest",
      "args": ["-q"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "problemMatcher": []
    }
  ]
}